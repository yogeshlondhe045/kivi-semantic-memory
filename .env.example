# ---------------------------------------------------------------------------
# Kivi semantic memory — environment
#
# Copy to `.env` before running:  cp .env.example .env
# The system starts and evaluates with this file COPIED UNCHANGED. No key is
# required. Supplying a key upgrades the pipeline from the deterministic
# offline provider to a real model.
# ---------------------------------------------------------------------------

# Which model provider runs extraction, planning and Hey Kivi answers.
#   local      deterministic, no network, no credentials  (default)
#   anthropic  real model calls, requires ANTHROPIC_API_KEY
LLM_PROVIDER=local

# Required only when LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# Model that runs the Hey Kivi conversation.
ANTHROPIC_MODEL=claude-opus-5

# Model that reads dictations during ingestion. Ingestion is one cheap pass over
# every record, so it defaults to a smaller model than the conversation.
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5

# Optional: override the Anthropic API base URL (proxies, gateways).
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# HTTP port for the Kivi backend (also serves the built web interface).
PORT=8787

# Port used by the Vite dev server during `npm run dev`.
WEB_PORT=5173

# SQLite database file. Relative paths resolve from the repository root.
DATABASE_URL=./data/kivi.db

# Deterministic seed for the corpus generator and the offline provider.
KIVI_SEED=20260214

# Log level: silent | error | info | debug
LOG_LEVEL=info
