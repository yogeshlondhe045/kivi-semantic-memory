# Copy to .env and adjust. Every variable the system reads is listed here;
# nothing in the code reads an environment variable that is absent from this
# file (they are all declared on kivi.config.Settings).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Used by the application and by `alembic upgrade head`.
# Inside Docker Compose the host is `db`; running natively it is localhost.
KIVI_DATABASE_URL=postgresql+psycopg://kivi:kivi@localhost:5432/kivi

# Consumed by docker-compose.yml only.
POSTGRES_USER=kivi
POSTGRES_PASSWORD=kivi
POSTGRES_DB=kivi
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Chat and embeddings are configured separately because vendors do not sell
# them as a pair -- the Claude API has no embeddings endpoint, so an Anthropic
# chat provider must be combined with a different embedder. See docs/adr/0003.
#
# Both default to `offline`: a deterministic, no-network, no-key path so the
# full pipeline and the evaluation run for a reviewer who supplies no
# credentials at all. Offline quality is lower, and the application says so
# on screen rather than hiding it.
#
#   chat      : offline | anthropic | openai | sarvam
#   embedding : offline | openai | sarvam
KIVI_CHAT_PROVIDER=offline
KIVI_EMBEDDING_PROVIDER=offline
KIVI_CHAT_MODEL=offline-rules-v1
KIVI_EMBEDDING_MODEL=offline-hash-v1

# Supply only the key for the provider(s) selected above. Never commit a real
# key -- this file is the example; .env is gitignored.
KIVI_ANTHROPIC_API_KEY=
KIVI_OPENAI_API_KEY=
KIVI_SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# Admission policy
# ---------------------------------------------------------------------------
# Exposed as configuration rather than buried as literals so the evaluation can
# sweep them and show the precision/recall tradeoff instead of asserting one.
KIVI_ADMISSION_CONFIDENCE_FLOOR=0.35
KIVI_ACTIVE_PROMOTION_CONFIDENCE=0.60
KIVI_CORROBORATION_MIN_SOURCES=2

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
KIVI_RETRIEVAL_CANDIDATE_LIMIT=40
KIVI_RETRIEVAL_CONTEXT_LIMIT=8
KIVI_RETRIEVAL_SCORE_THRESHOLD=0.25
KIVI_RRF_K=60

# Fixed seed keeps corpus generation and the evaluation reproducible.
KIVI_SEED=20260914
